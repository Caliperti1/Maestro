# Values are examples or placeholders only. Never commit real credentials.

# Exact deployed Vercel origin; no trailing slash.
FRONTEND_ORIGIN=https://maestro.example.com
CORS_ALLOW_ORIGINS=https://maestro.example.com

# Hosted model providers used by the initial cloud process.
OPENROUTER_API_KEY=replace-in-render
OPENAI_API_KEY=replace-in-render

# The Blueprint supplies DATABASE_URL from Render Postgres.
# DATABASE_URL=postgresql+psycopg://user:password@host/database

# Vercel project variable (configure in Vercel, not Render).
VITE_API_BASE_URL=https://api.maestro.example.com

# Reserved for the single-owner auth integration. These names are illustrative until the
# authentication middleware lands; do not assume setting them protects the service.
OWNER_OIDC_ISSUER=https://issuer.example.com
OWNER_OIDC_CLIENT_ID=replace-in-render
OWNER_OIDC_CLIENT_SECRET=replace-in-render
OWNER_OIDC_SUBJECT=replace-in-render
SESSION_SECRET=replace-in-render
